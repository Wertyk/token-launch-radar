{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "main.ts",
      "src/**",
      "test/**",
      "tools/**",
      "vitest.config.ts",
      "dashboard/0-guide.md",
      "dashboard/index.html",
      "dashboard/4-app.css",
      "biome.json",
      "package.json",
      "tsconfig.*.json",
      "!!vendor",
      "!!dashboard/2-core.js",
      "!!dashboard/3-ui.js",
      "!!dashboard/5-extras.js",
      "!!out",
      "!!node_modules",
      "!!AGENTS.md",
      "!!CLAUDE.md",
      "!!backlog",
      "!!docs",
      "!!.orchestra"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "useNodejsImportProtocol": "error" }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": { "enabled": true }
  }
}

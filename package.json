{
  "name": "token-launch-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Offline radar that ranks DeFi protocols recording no token by implied launch value, with a costed farm plan for each",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.tools.json",
    "lint": "biome check",
    "format": "biome format --write",
    "arch": "node .dependency-cruiser.cjs",
    "test": "vitest run",
    "build:web": "node tools/build-web.ts",
    "radar": "node main.ts --input ../token-radar-kit/token-radar-01-kit/input/snapshot.json --output out",
    "shots": "node tools/screenshots.ts",
    "gate": "node tools/gate.ts --out out --input ../token-radar-kit/token-radar-01-kit/input/snapshot.json",
    "sandbox": "bash tools/sandbox.sh",
    "verify": "pnpm typecheck && pnpm lint && pnpm arch && pnpm test && pnpm build:web --check && pnpm radar && pnpm gate"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.23.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.9.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
